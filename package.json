{
  "name": "wyss-console",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=12.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json && tsc --project tsconfig.tools.json",
    "test": "vitest run",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "rust:fmt": "node scripts/tool.mjs cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "rust:check": "node scripts/tool.mjs cargo check --locked --manifest-path src-tauri/Cargo.toml",
    "rust:test": "node scripts/tool.mjs cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "rust:clippy": "node scripts/tool.mjs cargo clippy --locked --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "check:rust": "npm run rust:fmt && npm run rust:check && npm run rust:test && npm run rust:clippy",
    "desktop:dev": "node scripts/tool.mjs tauri dev",
    "desktop:build": "node scripts/tool.mjs tauri build --no-bundle -- --locked",
    "desktop:run": "node scripts/tool.mjs app",
    "desktop:package": "node scripts/package.mjs",
    "release:package": "node scripts/package.mjs --release",
    "release:verify": "node scripts/release-verify.mjs --repo",
    "test:pty": "node scripts/tool.mjs cargo test --locked --manifest-path src-tauri/Cargo.toml terminal:: && vitest run tests/terminal-client.test.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "svelte": "5.57.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "26.6.4",
    "eslint": "10.12.0",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
